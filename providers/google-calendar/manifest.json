{
  "provider": {
    "id": "google-calendar",
    "name": "Google Calendar",
    "description": "Read upcoming events, create calendar events, and reschedule existing events in Google Calendar.",
    "oauth": {
      "provider": "google-calendar",
      "displayName": "Google Calendar",
      "description": "Connect Google Calendar to view, create, and reschedule events.",
      "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "clientIdEnv": "SKILL_ROUTER_OAUTH_GOOGLE_CLIENT_ID",
      "clientSecretEnv": "SKILL_ROUTER_OAUTH_GOOGLE_CLIENT_SECRET",
      "scopes": [
        "openid",
        "email",
        "profile",
        "https://www.googleapis.com/auth/calendar.events"
      ],
      "usePKCE": true,
      "authorizeParams": {
        "access_type": "offline",
        "include_granted_scopes": "true",
        "prompt": "consent"
      },
      "tokenClientAuth": "request_body",
      "userInfo": {
        "url": "https://openidconnect.googleapis.com/v1/userinfo",
        "accountIdPath": "sub",
        "accountNamePath": "email",
        "accountAvatarPath": "picture"
      }
    }
  },
  "skills": [
    {
      "id": "events",
      "name": "Events",
      "description": "Read upcoming events, create calendar events, and reschedule existing events in Google Calendar."
    }
  ]
}
