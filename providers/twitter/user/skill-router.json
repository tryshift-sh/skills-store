{
  "provider": "twitter",
  "skill": "user",
  "name": "user",
  "description": "Retrieve the authenticated Twitter user profile.",
  "installSkillIds": [
    "tryshift-sh/skills-store/twitter/post"
  ],
  "actions": {
    "me": {
      "slotName": "twitter-oauth",
      "upstream": {
        "method": "GET",
        "baseUrl": "https://api.x.com",
        "path": "/2/users/me",
        "auth": { "mode": "bearer" }
      },
      "outputTransform": "twitter-user-me"
    }
  }
}
