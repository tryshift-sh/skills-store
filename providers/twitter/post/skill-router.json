{
  "provider": "twitter",
  "skill": "post",
  "name": "post",
  "description": "Post, reply, quote, and delete tweets on Twitter / X.",
  "installSkillId": "tryshift-sh/skills-store/twitter/post",
  "actions": {
    "create": {
      "slotName": "twitter-oauth",
      "upstream": {
        "method": "POST",
        "baseUrl": "https://api.x.com",
        "path": "/2/tweets",
        "auth": { "mode": "bearer" }
      },
      "inputTransform": "twitter-post-create",
      "outputTransform": "twitter-tweet-created"
    },
    "reply": {
      "slotName": "twitter-oauth",
      "upstream": {
        "method": "POST",
        "baseUrl": "https://api.x.com",
        "path": "/2/tweets",
        "auth": { "mode": "bearer" }
      },
      "inputTransform": "twitter-post-reply",
      "outputTransform": "twitter-tweet-created"
    },
    "quote": {
      "slotName": "twitter-oauth",
      "upstream": {
        "method": "POST",
        "baseUrl": "https://api.x.com",
        "path": "/2/tweets",
        "auth": { "mode": "bearer" }
      },
      "inputTransform": "twitter-post-quote",
      "outputTransform": "twitter-tweet-created"
    },
    "delete": {
      "slotName": "twitter-oauth",
      "upstream": {
        "method": "DELETE",
        "baseUrl": "https://api.x.com",
        "path": "/2/tweets/{tweetId}",
        "auth": { "mode": "bearer" }
      },
      "outputTransform": "twitter-tweet-deleted"
    }
  }
}
