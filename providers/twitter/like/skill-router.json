{
  "provider": "twitter",
  "skill": "like",
  "name": "like",
  "description": "Like and unlike tweets.",
  "installSkillId": "tryshift-sh/skills-store/twitter/like",
  "actions": {
    "create": {
      "slotName": "twitter-oauth",
      "upstream": {
        "method": "POST",
        "baseUrl": "https://api.x.com",
        "path": "/2/users/{userId}/likes",
        "auth": { "mode": "bearer" }
      },
      "inputTransform": "twitter-like-create",
      "outputTransform": "twitter-like-result"
    },
    "delete": {
      "slotName": "twitter-oauth",
      "upstream": {
        "method": "DELETE",
        "baseUrl": "https://api.x.com",
        "path": "/2/users/{userId}/likes/{tweetId}",
        "auth": { "mode": "bearer" }
      },
      "outputTransform": "twitter-unlike-result"
    }
  }
}
