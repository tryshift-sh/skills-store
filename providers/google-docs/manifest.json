{
  "provider": {
    "id": "google-docs",
    "name": "Google Docs",
    "description": "Create, edit, and share Google Docs documents created through Shift.",
    "oauth": {
      "provider": "google-docs",
      "displayName": "Google Docs",
      "description": "Connect Google Docs to create documents, edit content, and manage sharing for documents created through Shift.",
      "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "clientIdEnv": "SKILL_ROUTER_OAUTH_GOOGLE_CLIENT_ID",
      "clientSecretEnv": "SKILL_ROUTER_OAUTH_GOOGLE_CLIENT_SECRET",
      "scopes": [
        "openid",
        "email",
        "profile",
        "https://www.googleapis.com/auth/drive.file"
      ],
      "usePKCE": true,
      "authorizeParams": {
        "access_type": "offline",
        "include_granted_scopes": "true",
        "prompt": "consent"
      },
      "tokenClientAuth": "request_body",
      "userInfo": {
        "url": "https://openidconnect.googleapis.com/v1/userinfo",
        "accountIdPath": "sub",
        "accountNamePath": "email",
        "accountAvatarPath": "picture"
      }
    }
  },
  "skills": [
    {
      "id": "documents",
      "name": "Documents",
      "description": "Create, edit, and share Google Docs documents created through Shift."
    }
  ]
}
