{
  "provider": {
    "id": "google-drive",
    "name": "Google Drive",
    "description": "Browse files, upload content, inspect metadata, create folders, and manage sharing in Google Drive.",
    "oauth": {
      "provider": "google-drive",
      "displayName": "Google Drive",
      "description": "Connect Google Drive to browse files, upload content, create folders, and manage sharing.",
      "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "clientIdEnv": "SKILL_ROUTER_OAUTH_GOOGLE_CLIENT_ID",
      "clientSecretEnv": "SKILL_ROUTER_OAUTH_GOOGLE_CLIENT_SECRET",
      "scopes": [
        "openid",
        "email",
        "profile",
        "https://www.googleapis.com/auth/drive"
      ],
      "usePKCE": true,
      "authorizeParams": {
        "access_type": "offline",
        "include_granted_scopes": "true",
        "prompt": "consent"
      },
      "tokenClientAuth": "request_body",
      "userInfo": {
        "url": "https://openidconnect.googleapis.com/v1/userinfo",
        "accountIdPath": "sub",
        "accountNamePath": "email",
        "accountAvatarPath": "picture"
      }
    }
  },
  "skills": [
    {
      "id": "files",
      "name": "Files",
      "description": "Browse files, upload content, inspect metadata, create folders, and manage sharing in Google Drive."
    }
  ]
}
