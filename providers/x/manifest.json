{
  "provider": {
    "id": "x",
    "name": "X",
    "description": "Managed X skills with built-in Agent Secrets support.",
    "oauth": {
      "provider": "twitter",
      "displayName": "X (Twitter)",
      "description": "Connect your X account for posting, likes, retweets, and more.",
      "authorizeUrl": "https://x.com/i/oauth2/authorize",
      "tokenUrl": "https://api.x.com/2/oauth2/token",
      "clientIdEnv": "TWITTER_CLIENT_ID",
      "clientSecretEnv": "TWITTER_CLIENT_SECRET",
      "scopes": ["tweet.read", "tweet.write", "users.read", "like.write", "offline.access"],
      "usePKCE": true,
      "userInfo": {
        "url": "https://api.x.com/2/users/me",
        "accountIdPath": "data.id",
        "accountNamePath": "data.username",
        "accountNamePrefix": "@"
      }
    }
  },
  "skills": [
    {
      "id": "post",
      "skill": "post",
      "installSkillName": "post",
      "name": "post",
      "description": "Post, reply, quote, and delete posts on X.",
      "agentSecretsSupported": true,
      "skillRouterManifestPath": "providers/x/post/skill-router.json"
    },
    {
      "id": "like",
      "skill": "like",
      "installSkillName": "like",
      "name": "like",
      "description": "Like and unlike posts on X.",
      "agentSecretsSupported": true,
      "listedInStore": false,
      "skillRouterManifestPath": "providers/x/like/skill-router.json"
    },
    {
      "id": "retweet",
      "skill": "retweet",
      "installSkillName": "retweet",
      "name": "retweet",
      "description": "Repost and undo reposts on X.",
      "agentSecretsSupported": true,
      "listedInStore": false,
      "skillRouterManifestPath": "providers/x/retweet/skill-router.json"
    },
    {
      "id": "timeline",
      "skill": "timeline",
      "installSkillName": "timeline",
      "name": "timeline",
      "description": "Read home timeline, user posts, and mentions on X.",
      "agentSecretsSupported": true,
      "listedInStore": false,
      "skillRouterManifestPath": "providers/x/timeline/skill-router.json"
    },
    {
      "id": "user",
      "skill": "user",
      "installSkillName": "user",
      "name": "user",
      "description": "Retrieve the authenticated X account profile.",
      "agentSecretsSupported": true,
      "listedInStore": false,
      "skillRouterManifestPath": "providers/x/user/skill-router.json"
    }
  ]
}
