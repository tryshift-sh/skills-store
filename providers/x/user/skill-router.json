{
  "id": "user",
  "name": "User Profile",
  "description": "Retrieve the authenticated X account profile.",
  "actions": {
    "me": {
      "upstream": {
        "method": "GET",
        "baseUrl": "https://api.x.com",
        "path": "/2/users/me",
        "auth": { "mode": "bearer" }
      },
      "output": {
        "responseSelect": "data",
        "responseMap": {
          "id": "$data.id",
          "name": "$data.name",
          "username": "$data.username"
        }
      }
    }
  }
}
