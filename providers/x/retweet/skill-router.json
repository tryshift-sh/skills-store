{
  "provider": "x",
  "skill": "retweet",
  "name": "retweet",
  "description": "Retweet and unretweet tweets.",
  "installSkillId": "tryshift-sh/skills-store/x/retweet",
  "actions": {
    "create": {
      "slotName": "x-oauth",
      "upstream": {
        "method": "POST",
        "baseUrl": "https://api.x.com",
        "path": "/2/users/{userId}/retweets",
        "auth": { "mode": "bearer" }
      },
      "input": {
        "bodyTemplate": {
          "tweet_id": "$input.tweetId"
        }
      },
      "output": {
        "responseSelect": "data",
        "responseMap": {
          "retweeted": {
            "$value": "$data.retweeted",
            "$default": false
          }
        }
      }
    },
    "delete": {
      "slotName": "x-oauth",
      "upstream": {
        "method": "DELETE",
        "baseUrl": "https://api.x.com",
        "path": "/2/users/{userId}/retweets/{tweetId}",
        "auth": { "mode": "bearer" }
      },
      "output": {
        "responseSelect": "data",
        "responseMap": {
          "retweeted": {
            "$not": "$data.retweeted",
            "$default": true
          }
        }
      }
    }
  }
}
